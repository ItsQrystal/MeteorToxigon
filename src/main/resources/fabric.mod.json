{
  "schemaVersion": 1,
  "id": "toxigon",
  "version": "${version}",
  "name": "Toxigon",
  "description": "Extra mods for meteor client",
  "authors": [
    "qrystalgg"
  ],
  "icon": "assets/toxigon/icon.png",
  "environment": "client",
  "entrypoints": {
    "meteor": [
      "me.qrystalgg.toxigon.Toxigon"
    ]
  },
  "mixins": [
    "toxigon.mixins.json"
  ],
  "custom": {
    "meteor-client:color": "225,25,25"
  },
  "depends": {
    "java": ">=21",
    "minecraft": ["${mc_version}"],
    "meteor-client": "*"
  }
}
